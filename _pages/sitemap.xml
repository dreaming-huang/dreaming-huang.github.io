---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}
  {% assign skip_page = false %}
  {% assign page_url = page.url | downcase %}
  {% if page.sitemap == false or page_url == "/sitemap.xml" %}{% assign skip_page = true %}{% endif %}
  {% if page_url contains ".css" or page_url contains ".js" or page_url contains ".json" or page_url contains ".xml" or page_url contains ".txt" %}{% assign skip_page = true %}{% endif %}
  {% unless skip_page %}
  <url>
    <loc>{{ site.url }}{{ page.url | replace: "index.html", "" }}</loc>
    {% if page.last_modified_at %}<lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {% elsif page.date %}<lastmod>{{ page.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endunless %}
{% endfor %}
{% for post in site.posts %}
  {% unless post.sitemap == false %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endunless %}
{% endfor %}
{% for collection in site.collections %}
  {% unless collection.output == false or collection.label == "posts" %}
    {% for doc in collection.docs %}
      {% unless doc.sitemap == false %}
  <url>
    <loc>{{ site.url }}{{ doc.url }}</loc>
    {% if doc.date %}<lastmod>{{ doc.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
      {% endunless %}
    {% endfor %}
  {% endunless %}
{% endfor %}
{% for file in site.static_files %}
  {% assign ext = file.extname | downcase %}
  {% if ext == ".html" %}
    {% unless file.path contains "/talkmap/" or file.path contains "/markdown_generator/" %}
      {% assign file_loc = file.path | replace: "/index.html", "/" %}
  <url>
    <loc>{{ site.url }}{{ file_loc }}</loc>
    <lastmod>{{ file.modified_time | date_to_xmlschema }}</lastmod>
  </url>
    {% endunless %}
  {% endif %}
{% endfor %}
{% for extra in site.data.sitemap_extra.urls %}
  <url>
    <loc>{{ extra.loc }}</loc>
    {% if extra.lastmod %}<lastmod>{{ extra.lastmod }}</lastmod>{% endif %}
  </url>
{% endfor %}
</urlset>
